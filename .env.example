# Copy to .env.local and fill in from the Supabase dashboard:
# Project Settings → API. Both values also go into Vercel's project env vars.
#
# The anon key is safe to expose to the browser — its permissions are defined
# entirely by RLS policies (architecture doc §3, §6).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_, never commit a real value.
# Bypasses RLS entirely; used only by lib/supabase/admin.ts.
# REQUIRED since Stage 3: the /attend check-in Server Action writes with it.
# Also required in Vercel (add via CLI, not the dashboard — see tasks.md).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only, and REQUIRED for check-in location verification (§6) to record
# anything. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# It makes a stored origin digest irreversible. IPv4 is 4.3 billion addresses,
# so an unpeppered SHA-256 of one is reversible on a laptop in seconds — and
# this repository is public, so the value can never live in it.
#
# Missing is SAFE, not broken: nothing is hashed, every review row reads
# "origin unknown", and no check-in fails. Rotating it orphans every digest
# already stored, which only matters within an event that has not been
# reviewed yet.
CHECKIN_ORIGIN_PEPPER=
